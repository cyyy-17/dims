# DIMS - Dormitory & Inventory Management System
# Configuration for Supabase & Brevo Email Service
# Copy this file to .env.local and fill in your actual credentials

# Supabase Credentials (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Brevo (formerly Sendinblue) Transactional & Bulk Email API
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
NEXT_PUBLIC_BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=your-verified-sender@school.edu.ph
NEXT_PUBLIC_BREVO_SENDER_EMAIL=your-verified-sender@school.edu.ph
BREVO_SENDER_NAME=ASR Dormitory Office
NEXT_PUBLIC_BREVO_SENDER_NAME=ASR Dormitory Office

# App Settings
NEXT_PUBLIC_APP_NAME=DIMS
NEXT_PUBLIC_APP_CAMPUS=ASR School Field Campus
